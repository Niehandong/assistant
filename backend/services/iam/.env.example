# iam 服务配置示例（复制为 .env 覆盖；均有本地开发默认值）
APP_ENV=dev
HOST=127.0.0.1
PORT=8301
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://kbp:kbp@localhost:15432/kbp
REDIS_URL=redis://localhost:16379/0
REDIS_MAX_CONNECTIONS=100
REDIS_POOL_TIMEOUT_SECONDS=5

# 数据库连接池：单进程最多 DB_POOL_SIZE + DB_MAX_OVERFLOW 个连接；取连接超过 DB_POOL_TIMEOUT_SECONDS 返回 503001
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# JWT：iam 持私钥签发，其他服务只持公钥验签（相对路径按 backend/ 解析；密钥由 devctl.py init 生成）
JWT_PRIVATE_KEY_FILE=.secrets/jwt_private.pem
JWT_PUBLIC_KEY_FILE=.secrets/jwt_public.pem
JWT_ISSUER=kbp-iam
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

INTERNAL_API_TOKEN=dev-internal-token-change-me

LOGIN_MAX_FAILURES=5
LOGIN_FAIL_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# Seed（生产务必修改初始密码）
SEED_ADMIN_PASSWORD=Admin12345
SEED_GROUP_NAME=集团
SEED_GROUP_CODE=GROUP

LOG_RETENTION_DAYS=180
LOG_JOBS_ENABLED=true
# M2/M3 接入后再开启：组织/用户停用与删除前向 kb/open 查询影响数
KB_STATS_ENABLED=false
OPEN_STATS_ENABLED=false
