# kb 服务配置示例（复制为 .env 覆盖；均有本地开发默认值）
APP_ENV=dev
HOST=127.0.0.1
PORT=8302
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://kbp:kbp@localhost:15432/kbp
REDIS_URL=redis://localhost:16379/0
REDIS_MAX_CONNECTIONS=100
REDIS_POOL_TIMEOUT_SECONDS=5
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# 鉴权：kb 只持公钥验签；权限上下文经 iam 内部接口获取
JWT_PUBLIC_KEY_FILE=.secrets/jwt_public.pem
JWT_ISSUER=kbp-iam
IAM_INTERNAL_URL=http://127.0.0.1:8301
INTERNAL_API_TOKEN=dev-internal-token-change-me

# 对象存储（本地 MinIO，桶由 devctl.py init 创建）
S3_ENDPOINT=http://127.0.0.1:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kbp-files
S3_REGION=us-east-1

# 模型凭据 Fernet 密钥；生产（APP_ENV 非 dev/test）必须覆盖，否则拒绝启动
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_SECRET_KEY=a2JwLWRldi1tb2RlbC1zZWNyZXQta2V5LTMyYnl0ZXM=

UPLOAD_MAX_BYTES=15728640
DATASET_MAX_DOCUMENTS=10000
UPLOAD_FILE_TTL_HOURS=24
PARSE_PROCESS_WORKERS=2
PARSE_TIMEOUT_SECONDS=60
WORKER_CONCURRENCY=4
EMBED_BATCH_SIZE=16
MODEL_HTTP_TIMEOUT_SECONDS=30
PROCESS_TIMEOUT_MINUTES=30
QUEUED_REDELIVER_MINUTES=30
SWEEP_INTERVAL_SECONDS=60
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
# 约束：必须大于 DOC_LOCK_TTL_SECONDS，否则 worker 启动校验失败（接管时旧锁未过期会丢弃任务）
TASK_CLAIM_IDLE_SECONDS=600
DOC_LOCK_TTL_SECONDS=90
REF_RECONCILE_INTERVAL_SECONDS=600
HIT_FLUSH_INTERVAL_SECONDS=60
QUERY_EMBED_CACHE_SECONDS=600
RETRIEVAL_CANDIDATE_MAX=100
JIEBA_USER_DICT=
FULLTEXT_DROP_STOPWORDS=true

# 检索性能（BE-21b）
VECTOR_EXACT_MAX_ROWS=20000
HNSW_EF_SEARCH=200
HNSW_MAX_SCAN_TUPLES_MIN=20000
HNSW_MAX_SCAN_TUPLES_MAX=200000
HNSW_M=16
HNSW_EF_CONSTRUCTION=128
VECTOR_INDEX_RECONCILE_SECONDS=600
FULLTEXT_PRUNE_MIN_ROWS=20000
FULLTEXT_COMMON_TERM_RATIO=0.15
FULLTEXT_CANDIDATE_CAP=10000
FULLTEXT_COMMON_TERMS_REFRESH_SECONDS=21600
