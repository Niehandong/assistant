# open 服务配置示例（复制为 .env 覆盖；均有本地开发默认值）
APP_ENV=dev
HOST=127.0.0.1
PORT=8303
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://kbp:kbp@localhost:15432/kbp
REDIS_URL=redis://localhost:16379/0
REDIS_MAX_CONNECTIONS=100
REDIS_POOL_TIMEOUT_SECONDS=5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# 鉴权：open 只持公钥验签；权限上下文经 iam 内部接口获取
JWT_PUBLIC_KEY_FILE=.secrets/jwt_public.pem
JWT_ISSUER=kbp-iam
IAM_INTERNAL_URL=http://127.0.0.1:8301
KB_INTERNAL_URL=http://127.0.0.1:8302
INTERNAL_API_TOKEN=dev-internal-token-change-me

# 只信任前端 Nginx 的地址（生产不得包含 127.0.0.1 / 0.0.0.0/0），否则可伪造 X-Forwarded-For 绕过 IP 白名单
TRUSTED_PROXIES=["127.0.0.1/32","::1/128"]

# API 密钥哈希用的 HMAC 密钥；生产（APP_ENV 非 dev/test）必须覆盖，否则拒绝启动
# 注意：一旦设置不可更换，更换会使全部已发放的 API 密钥失效
# 生成：openssl rand -hex 32
API_KEY_PEPPER=dev-api-key-pepper-change-me
API_KEY_CACHE_SECONDS=300

# 开放检索转发到 kb（可指向 kb 的检索组实例）
KB_RETRIEVAL_URL=http://127.0.0.1:8302
OPEN_RETRIEVE_TIMEOUT_SECONDS=15

CALL_LOG_RETENTION_DAYS=180
CALL_LOG_CLEANUP_INTERVAL_SECONDS=86400
CALL_LOG_CLEANUP_BATCH=5000
INVALID_KEY_LOG_PER_IP_PER_MIN=20
REF_RECONCILE_INTERVAL_SECONDS=600

# 是否在 open 进程内启动事件消费者/定时任务（测试环境可置 false）
BACKGROUND_JOBS_ENABLED=true
