# 生产环境变量模板：复制为 deploy/.env.prod（不进 git）并替换全部 <...> 占位符。
# 用法：docker compose -p kbp-prod --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml up -d --build
# 密码类变量请使用 openssl rand -hex 24 这类仅含字母数字的随机串（会被拼入连接 URL，不要含 @ : / # 等字符）。

# ---- 镜像与访问入口 ----
KBP_VERSION=dev
# nginx 映射到宿主机的端口（生产常用 80；前面还有负载均衡/HTTPS 终结时按需调整）
NGINX_HOST_PORT=80

# ---- 网络（nginx 固定地址即 TRUSTED_PROXIES，改网段时两者同步）----
KBP_SUBNET=172.31.77.0/24
NGINX_IP=172.31.77.10

# ---- 密钥（全部必须替换；不能使用示例值）----
# 内部接口令牌：>= 32 位随机串，保持开发默认值时服务拒绝启动。生成：openssl rand -hex 32
INTERNAL_API_TOKEN=<openssl rand -hex 32>
# 模型凭据加密 Fernet key。生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_SECRET_KEY=<Fernet key>
# API 密钥哈希 pepper：一经设置不可更换，否则已发放的 API 密钥全部失效。生成：openssl rand -hex 32
API_KEY_PEPPER=<openssl rand -hex 32>
# 初始 admin 密码（首次登录强制修改）
SEED_ADMIN_PASSWORD=<初始管理员密码>

# JWT 密钥对所在目录（宿主机路径），含 jwt_private.pem 与 jwt_public.pem，生成方法见 README
JWT_KEYS_DIR=/opt/kbp/secrets
JWT_ISSUER=kbp-iam

# ---- 数据库（每个服务独立账号：kbp_iam / kbp_kb / kbp_open，各自为自己 schema 的 owner）----
POSTGRES_USER=kbp_admin
POSTGRES_PASSWORD=<openssl rand -hex 24>
IAM_DB_PASSWORD=<openssl rand -hex 24>
KB_DB_PASSWORD=<openssl rand -hex 24>
OPEN_DB_PASSWORD=<openssl rand -hex 24>

# ---- Redis / MinIO ----
REDIS_PASSWORD=<openssl rand -hex 24>
MINIO_ROOT_USER=<minio 管理账号>
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>
S3_BUCKET=kbp-files

# ---- PostgreSQL 参数（默认值按 16 核 / 64GB 专用 DB 主机；按实际内存等比例缩放，换算见 README）----
PG_SHARED_BUFFERS=16GB
PG_EFFECTIVE_CACHE_SIZE=48GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=8GB
PG_SHM_SIZE=16gb
PG_MAX_WORKER_PROCESSES=32
PG_MAX_PARALLEL_WORKERS=16
PG_MAX_PARALLEL_MAINTENANCE_WORKERS=8
PG_MAX_CONNECTIONS=400

# ---- 其他（可选）----
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
# open 调 kb 检索的地址；kb 拆出独立"检索组"实例后改为该实例地址
KB_RETRIEVAL_URL=http://kb:8302
